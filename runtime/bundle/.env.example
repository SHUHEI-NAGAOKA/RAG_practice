# 持ち出し用の設定（export.sh が BUNDLE_TAG を書き込んだ .env を同梱する）

# 使うイメージの版（build.sh で付けたタグ）
BUNDLE_TAG=

# LLM（イメージに入れたモデルだけ使える。既定は qwen2.5:3b）
LLM_MODEL=qwen2.5:3b
NUM_CTX=8192

# 検索方式: dense / bm25 / hybrid
SEARCH_MODE=dense
HYBRID_PREFETCH=30
SUMMARY_DEDUP=true
SUMMARY_DEDUP_CHARS=10

# 画面・API のポート（このマシンからだけ見られる）
API_PORT=8000
