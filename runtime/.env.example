# RAG 実行環境の設定（cp .env.example .env でコピーして書き換える）

# LLM のモデル（3B と 7B の切り替え）: qwen2.5:3b / qwen2.5:7b
LLM_MODEL=qwen2.5:3b
# LLM のコンテキスト長（トークン）
NUM_CTX=8192

# 検索方式: dense（Ruri のベクトル）/ bm25（全文索引の BM25）/ hybrid（両方を RRF で統合）
SEARCH_MODE=dense
# hybrid で dense・BM25 からそれぞれ取る候補数
HYBRID_PREFETCH=30
# LLM に渡す資料の重なった【要約】をまとめる（先頭 N 文字が同じ要約は「【要約S1と同じ】」にする）
SUMMARY_DEDUP=true
SUMMARY_DEDUP_CHARS=10

# 評価モード（RAGAS 用の記録）。本番では false
EVAL_ENABLED=false
# 評価の質問集と記録を置くホストのフォルダ（このフォルダからの相対パスか絶対パス）
EVAL_HOST_DIR=./eval
EVAL_TESTSET=testset_v2.jsonl

# ホスト側のポート
API_PORT=8000
QDRANT_PORT=6333
OLLAMA_PORT=11434

# Ollama のモデルを置くボリューム名（既存のボリュームを使うときだけ書き換える）
OLLAMA_VOLUME=rag_practice_ollama_models

# pull_models.sh で入れるモデル（空白区切り）
OLLAMA_MODELS="qwen2.5:3b qwen2.5:7b"
